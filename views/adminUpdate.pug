extends base

block content
    .heading-box
        h1.heading-primary Edit and update data 
    .dashboard__container
        p Select the Edit button where you want to make changes in the table below.
        | When finished, select the Update button below.
        button.btn.update-btn(type='button')
            span.btn__text(id='btn__text') Update
            svg.btn__check(viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                polyline(points="16 5 8 14 4 10" pathLength="24")
    .dashboard__container
        