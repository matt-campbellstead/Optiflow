mixin showShipmentDetails(model)
    .shipment-box-detail
        table 
            thead Shipment Details
                tr
                    th ID:
                    td=`${model.id}`
                tr
                    th Incoterms: 
                    td=`${model.incoterms}`
                tr
                    th Routing:
                    td=`${model.routing}`
                tr
                    th Goods:
                    td=`${model.goodsDescriptions}`
                tr
                    th Type of packaging:
                    td=`${model.packagingType}`
                tr
                    th Container specifications:
                    td=`${model.containerSpecs}`
                tr
                    th Container quantity:
                    td=`${model.containerQty}`
                tr
                    th Number of items:
                    td=`${model.numItems}`
                tr
                    th Gross weight:
                    td=`${model.grossWeightKg}`
                tr
                    th Net weight:
                    td=`${model.netWeightKg}`
                tr
                    th Volumetric weight:
                    td=`${model.cbm}`
                tr
                    th Handling requirements:
                    td=`${model.handlingRequirements}`
                tr
                    th Dangerous goods?
                    td=`${model.dangerousGoods}`
                tr
                    th Dangerous goods code:
                    td=`${model.codeDrg}`
                tr
                    th Created At:
                    td=`${model.createdAt.toLocaleString('en-ZA', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: 'numeric' })}`
                tr    
                    th Updated at:
                    td=`${model.updatedAt.toLocaleString('en-ZA', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: 'numeric' })}`

mixin showCustomer(model)
    .shipment-box-detail 
        table
            thead Customer
                tr 
                    th ID:
                    td= `${model.id}`
                tr 
                    th Customer's user ID: 
                    td= `${model.userId}`
                tr 
                    th Company Name: 
                    td= `${model.companyName}`
                tr 
                    th Phone (landline): 
                    td= `${model.phoneLandline}`
                tr 
                    th Phone (mobile):
                    td= `${model.phoneMobile}`
                tr 
                    th Primary Email: 
                    td=`${model.emailPri}`
                tr 
                    th Secondary Email:
                    td=`${model.emailSec}`
                tr 
                    th Street: 
                    td=`${model.addressLine1}`
                tr 
                    th Suburb:
                    td=`${model.addressLine2}`
                tr 
                    th City & Province/State:
                    td=`${model.addressLine3}`
                tr 
                    th Country:
                    td=`${model.country}`
                tr 
                    th Created:
                    td=`${model.createdAt.toLocaleString('en-ZA', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: 'numeric' })}`
                tr 
                    th Updated:
                    td=`${model.updatedAt.toLocaleString('en-ZA', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: 'numeric' })}`

