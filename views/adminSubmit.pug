extends base

//- mixin formInput(text, class, required)
//-     .form__group
//-         label.form__label(for=`${class}`)= `${text}`
//-         input`#{class}`.form__input(type='text', placeholder='EXW', `${required}`)

block content
    h1.heading-primary Welcome to the data submission page 
    h2.heading-secondary Here, you can submit data into the database.
    section.dashboard__container
        section.update__container.first
            p See the drop-down menu for a list of current users
            select.db-select
                each customer of customers 
                    option=`${customer.name} ${customer._id}`
        section.update__container.second
            form.form.data-form__master
                h2.heading-secondary Master table
                p  NOTE: If you have not yet created a DB entry for the customer, do that first, then come back with the ID for that database entry.
                p  Enter the Shipment File number and the ID of the customer's user profile, then the ID of the customer's DB entry. The Master ID is set automatically.
                    .form__group
                        label.form__label(for="shipment_file_id") Shipment file no.
                        input#shipment_file_id.form__input(type='text', placeholder='1234567ABC', required)
                    .form__group
                        label.form__label(for="users") Customer's user ID string 
                        input#users.form__input(type='text', placeholder='e.g. 12a12345bc678de9101f2233 ', required)
                    .form__group
                        label.form__label(for='CustomerId') Customer's DB ID number
                        input#CustomerId.form__input(type='text', placeholder='e.g. "1"', required)
                    .form__group
                        input.btn.submit(type="submit")

    button.btn.next1 Next 
    include _formShipper
    button.btn.next2 Next
    include _formDetails
    button.btn.next3 Next
    include _formFinancials
    button.btn.next4 Next
    include _formCustoms
    button.btn.next5 Next
    include _formConveyance
    button.btn.next6 Next
    form.form.data-form__timeline
        h2.heading-secondary Timeline table
        p Enter the Master document ID below, then click 'submit' to initialise a Timeline table. All values will be false: they can then be updated as needed in the Ops Dashboard. 
            .form__group 
                label.form__label(for="timelineMasterId") Master ID number
                input.form__input(id="timelineMasterId", type="number", placeholder="e.g. 5")
            .form__group 
                input.btn.submit(type='submit')
    button.btn.next7 Next 
    include _formCustomers
    button.btn.next8 Next
    include _formConsignees
            
    h2.heading-seconday Your data entry: 
        section.dashboard__container
            p.data-preview