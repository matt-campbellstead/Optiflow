mixin formInput(id, type, label, placeholder)
    .form__group
        label.form__label(for=id)= label
        input.form__input(type=type, id=id, placeholder=placeholder)
form.form.data-form__customs
    h2.heading-secondary Customs table
   
    .form__group
        label.form__label(for='customsMasterId') Master ID
        input.form__input(type='number', id='customsMasterId', readonly)
    //- +formInput('customsMasterId', 'number', 'Master ID number', '1, 2, 3...' )
    +formInput('agent', 'text', 'Agent (uppercase required)', 'e.g. ABC LOGISTICS')
    +formInput('agentCode', 'text', 'Agent code', 'e.g. 1234567')
    +formInput('bOeNum', 'text', 'Bill of entry number', 'e.g. 1234567')
    +formInput('bOeReleaseDate', 'text', 'Bill of entry release date ', 'e.g. 20XX-XX-XX')
    +formInput('bOeAssessDate', 'text', 'Bill of entry assessment date', 'e.g. 20XX-XX-XX')
    +formInput('releaseDepot', 'text', 'Release depot', 'e.g. ABCDEF XYZ ')
    +formInput('lrnNum', 'text', 'LRN number', 'e.g. 123456')
    +formInput('mrnNum', 'text', 'MRN number', 'e.g. 123456' )
    p Fields marked with a '*' are required
    .form__group
        button.btn.submit(type="submit")
            span.btn__text(id='btn__text') Submit
            svg.btn__check(viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                polyline(points="16 5 8 14 4 10" pathLength="24")