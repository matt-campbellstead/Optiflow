mixin formInput(id, type, label, placeholder)
    .form__group
        label.form__label(for=id)= label
        input.form__input(type=type, id=id, placeholder=placeholder)
form.form.data-form__customs
    h2.heading-secondary Customs table
    p some text
    +formInput('MasterId', 'number', 'Master ID number', '1, 2, 3...' )
    +formInput('agent', 'text', 'Agent (uppercase required)', 'e.g. ABC LOGISTICS')
    +formInput('agentCode', 'text', 'Agent code', 'e.g. 1234567')
    +formInput('bOeNum', 'text', 'Bill of lading number', 'e.g. 1234567')
    +formInput('bOeReleaseDate', 'text', 'Bill of lading release date ', 'e.g. 20XX-XX-XX')
    +formInput('bOeAssessDate', 'text', 'Bill of lading assessment date', 'e.g. 20XX-XX-XX')
    +formInput('releaseDepot', 'text', 'Release depot', 'e.g. ABCDEF XYZ ')
    +formInput('lrnNum', 'text', 'LRN number', 'e.g. 123456')
    +formInput('mrnNum', 'text', 'MRN number', 'e.g. 123456' )
    .form__group
        input.btn.submit(type="submit")