extends baseE

block content
  p Hi #{firstName},
  p Forgot your password? No worries! Click the button below to visit the password reset page on Optiflow.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}?t=${token}`, target='_blank') Reset your password
  p If you didn't forget your password, please ignore this email!
