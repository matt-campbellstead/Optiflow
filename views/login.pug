extends base

block content
    .heading-box
        h1.heading-primary Log in to see your personalised dashboard 
    form.form.login-form
        .form__group 
            label.form__label(for='email') Email address 
            input#email.form__input(type='email', placeholder='you@example.com', required)   
        .form__group 
            label.form__label(for='password') Password 
            input#password.form__input(type='password', placeholder='••••••••', required, minlength='8')
        .form__group 
            button.btn(id="login-btn")
                span.btn__text(id='btn__text') Log in
                svg.btn__check(viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                    polyline(points="16 5 8 14 4 10" pathLength="24")
        .form__group 
            a.small-text(href='/reset-init') Forgotten password?
        .form__group
            a.small-text(href='/sign-up') Don't have an account?
