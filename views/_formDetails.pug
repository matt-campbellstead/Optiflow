mixin formInput(id, type, label, placeholder)
    .form__group
        label.form__label(for=id)= label
        input.form__input(type=type, id=id, placeholder=placeholder)
form.form.data-form__details
    h2.heading-secondary Shipment Details table
    
    .form__group
        label.form__label(for='detailsMasterId') Master ID
        input.form__input(type='number', id='detailsMasterId', readonly)
    //- +formInput('detailsMasterId', 'number', 'Master ID', 'e.g. 1')
    +formInput('incoterms', 'text', 'Incoterms', 'e.g. EXW')
    +formInput('mode', 'text', 'Mode', 'e.g. AIR')
    +formInput('routing', 'text', 'Routing', 'e.g. Import')
    +formInput('goodsDescriptions', 'text','Goods description', 'e.g. Some goods')
    +formInput('packagingType', 'text', 'Packaging type', 'e.g. Cartons')
    +formInput('containerQty', 'number', 'Shipping containers quantity', 'e.g. 10')
    +formInput('containerSpecs', 'text', 'Container specification', 'e.g. 40" GP')
    +formInput('numItems', 'number', 'Number of items', 'e.g. 10')
    +formInput('grossWeightKg', 'text','Gross weight in kilograms', '...kg' )
    +formInput('netWeightKg', 'text', 'Cargo net weight in kilograms', '...kg')
    +formInput('cbm', 'text', 'Cargo CBM', '...CBM')
    +formInput('handlingRequirements', 'text', 'Handling requirements (message)', 'Message here...')
    +formInput('dangerousGoods', 'text', 'Dangerous goods? (true OR false)', 'e.g. true')
    +formInput('codeDrg',  'text','DRG code', 'e.g. 123456')
    p Fields marked with a '*' are required
    .form__group 
        button.btn.submit(type='submit')
            span.btn__text(id='btn__text') Submit
            svg.btn__check(viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                    polyline(points="16 5 8 14 4 10" pathLength="24")