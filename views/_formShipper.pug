mixin formInput(id, label, placeholder)
    .form__group
        label.form__label(for=id)= label
        input.form__input(type='text', id=id, placeholder=placeholder)
form.form.data-form__shipper
    h2.heading-secondary Shipper table
    p some text
    +formInput('masterId', 'Master ID number', '1, 2, 3...' )
    +formInput('company', 'Company Name', 'SETSAIL CO. LTD.')
    +formInput('contact', 'Contact Name', 'John Smith')
    +formInput('phoneLand', 'Phone - Landline number', '+1 12345679')
    +formInput('phoneMobile', 'Phone - Mobile number', '+1 12345679')
    +formInput('emailPri', 'Primary email address', 'john@smith.com')
    +formInput('emailSec', 'Secondary email address', 'jane@smith.com')
    |
    +formInput('address1', 'Address - line 1', 'No. X, Unit X')
    +formInput('address2', 'Address - line 2', 'X St')
    +formInput('address3', 'Address - line 3', 'District X')
    +formInput('country', 'Country', 'UK/France/India/...')
    .form__group
        input.btn.submit(type='submit')