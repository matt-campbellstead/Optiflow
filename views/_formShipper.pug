mixin formInput(id, label, placeholder)
    .form__group
        label.form__label(for=id)= label
        input.form__input(type='text', id=id, placeholder=placeholder)
form.form.data-form__shipper
    h2.heading-secondary Shipper table
   
    .form__group
        label.form__label(for='shippersMasterId') Master ID
        input.form__input(type='number', id='shippersMasterId', readonly)
    
    +formInput('companyName', 'Company Name', 'SETSAIL CO. LTD.')
    +formInput('contactName', 'Contact Name', 'John Smith')
    +formInput('phoneLandline', 'Phone - Landline number', '+1 12345679')
    +formInput('phoneMobile', 'Phone - Mobile number', '+1 12345679')
    +formInput('emailPrimary', 'Primary email address', 'john@smith.com')
    +formInput('emailSecondary', 'Secondary email address', 'jane@smith.com')
    |
    +formInput('addressLine1', 'Address - line 1', 'No. X, Unit X')
    +formInput('addressLine2', 'Address - line 2', 'X St')
    +formInput('addressLine3', 'Address - line 3', 'District X')
    +formInput('country', 'Country', 'UK/France/India/...')
    p Fields marked with a '*' are required
    .form__group
        button.btn.submit(type='submit')
            span.btn__text(id='btn__text') Submit
            svg.btn__check(viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                polyline(points="16 5 8 14 4 10" pathLength="24")