extends base

block content
        .container 
            .error__title 
                h2.heading-secondary OOps! Something went wrong :^o
            h3.error__msg= msg
            .refresh-box(class='hidden')
                p if you did not log out, click below to refresh your session:
                button.btn.refresh-btn
                    span.btn__text(id='btn__text') Refresh
                    svg.btn__check(viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                        polyline(points="16 5 8 14 4 10" pathLength="24")