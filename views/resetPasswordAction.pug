extends base

block content
    .container
        h1 Password reset
        form.form.reset-password-action-form
          
            .form__group 
                label.form__label(for='password') Password 
                input#password.form__input(type='password', placeholder='••••••••', required, minlength='8')
        
            .form__group 
                label.form__label(for='passwordConfirm') Confirm your password 
                input#passwordConfirm.form__input(type='passwordConfirm', placeholder='••••••••', required, minlength='8') 

            .form__group 
                button.btn.btn__reset Reset 
