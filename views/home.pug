extends base

block append head
  script(src='https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.js')
  link(href='https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.css' rel='stylesheet')

block content   
    main.main
        if !user
            .map-container
                #map
            .container
                .heading-box.main--design-header
                    //-h2.heading-primary=`Today - ${new Date().toLocaleString('en-ZA', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' })} - in freight and logistics`
                    h1.main--title Today
                    h2.heading-secondary=new Date().toLocaleString('en-ZA', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' })
                    h2.main--title in freight and logistics
                .main--design-block
                    h2 Fuel prices
                    h3 Diesel
                    .data-item-box
                        //- p=`Diesel - Average per gallon: $ ${data.FreightApiFuelPrice.dataValues.dieselAvgPrice}`
                        p Average per gallon:
                        p=`$ ${data.FreightApiFuelPrice.dataValues.dieselAvgPrice}`
                    .data-item-box
                        p Price change:
                        div(class=`${data.FreightApiFuelPrice.dataValues.dieselPriceChangePercent > 0 ? 'price-red' : 'price-green'}`)
                            p=`% ${data.FreightApiFuelPrice.dataValues.dieselPriceChangePercent}`
                    .data-item-box
                        p Last updated:
                        p=data.FreightApiFuelPrice.dataValues.dieselUpdatedAt
                    h3 Gasoline 
                    .data-item-box 
                        p Average per gallon: 
                        p=`$ ${data.FreightApiFuelPrice.dataValues.gasolineAvgPrice}`
                    .data-item-box 
                        p Price change:
                        div(class=`${data.FreightApiFuelPrice.dataValues.gasolinePriceChangePercent > 0 ? 'price-red' : 'price-green'}`) 
                            p=`% ${data.FreightApiFuelPrice.dataValues.gasolinePriceChangePercent}`
                    .data-item-box 
                        p Last updated: 
                        p=`${data.FreightApiFuelPrice.dataValues.gasolineUpdatedAt}`
                    p.small-text=`Source: ${data.FreightApiFuelPrice.dataValues.infoSource}`
                
                .main--design-block 
                    h2 Port congestion - Cape Town
                    if (!data.FreightApiPortCongestion)
                        p Currently there is no available port congestion data 
                    if (data.FreightApiPortCongestion)
                        .data-item-box 
                            p Congestion: 
                            p=data.FreightApiPortCongestion.congestion
                        .data-item-box 
                            p As of: 
                            p=data.FreightApiPortCongestion.asOf 
                        
                
                .main--design-block 
                    h2 Possible Disruptions 
                        span - caused by natural disasters 
                    each object in data.FreightApiDisruptions
                        .data-item-box
                            p Disaster
                            p=`${object.dataValues.type}`
                        .data-item-box
                            p Severity 
                            p=object.dataValues.severity
                        .data-item-box 
                            p Location
                            p=object.dataValues.country
                        p.small-text=`Source: ${object.dataValues.source}, last updated: ${object.dataValues.updatedAt}` 

                
    if user
        .heading-box
            h1.main--title= `Welcome, ${user.name}, to your dashboard.`
                
        p.main--text 
            if (user.role === 'user')
                .section-pictures
                    .picture-box
                        a.nav__el.home--1(href='/dashboard')
                            span.nav__text View Your Shipments
                        a.nav__el.home--2(href='/me')
                            span.nav__text My Account settings
                        a.nav__el.home--3(href='/my-files')
                            span.nav__text Your Files Portal
                    
                    
                        
            if (user.role === 'admin') 
                .section-pictures
                    .picture-box
                        a.nav__el.home--1(href='/ops-dashboard')
                            span.nav__text View & Edit Shipment Files
                        a.nav__el.home--2(href='/me')
                            span.nav__text My Account settings
                        a.nav__el.home--3(href='/ops-data')
                            span.nav__text Create Shipment Files
                            
                            