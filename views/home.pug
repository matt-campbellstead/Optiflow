extends base

block content   
    main.main
    if !user 
        .main--dogs
    if user
        h1.main--title= `Welcome, ${user.name}, to your dashboard.`
        //- .section-pictures
        //-     .picture-box
        //-         img.picture-box__img(src="/img/marine-traffic-api-blog-isitix-54746943.jpg" class="picture-box__img--1")
        //-         img.picture-box__img(src="/img/victoria-and-alfred-harbour-sunrise-cape-town-picture-id1032782128-2653218752.jpg" class="picture-box__img--2")
        //-         img.picture-box__img(src="/img/shipping-containers-2611069854.jpg", class="picture-box__img--3")
        p.main--text   
        if user
            if (user.role === 'user')
                a#dashboard.nav__el(href='/dashboard') View dashboard
            
                
            if (user.role === 'admin') 
                .section-pictures
                    .picture-box
                        a.nav__el.home--1(href='/ops-dashboard')
                            span.nav__text View Operations dashboard
                        a.nav__el.home--2(href='/ops-functions')
                            span.nav__text View Ops functions
                        a.nav__el.home--3(href='/ops-data')
                            span.nav__text Submit data
                        a.nav__el.home--4(href='/ops-update')
                            span.nav__text Update data 
                        