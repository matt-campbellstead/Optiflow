mixin formInput(id, type, label, placeholder)
    .form__group
        label.form__label(for=id)= label
        input.form__input(type=type, id=id, placeholder=placeholder)
form.form.data-form__conveyance
    h2.heading-secondary Conveyance table
    p some text
    +formInput('conveyanceMasterId', 'number', 'Master ID number', '1, 2, 3...' )
    +formInput('loadPort', 'text', 'Port/Airport of load (uppercase required)', 'place...')
    +formInput('portTransShip', 'text', 'Transshipment of port/Airline hub (uppercase required)', 'place...')
    +formInput('portDischarge', 'text', 'Port/Airport of discharge (uppercase required)', 'place...')
    +formInput('inlandDestination', 'text', 'Inland destination (uppercase required)', 'place...')
    +formInput('finalDelivery', 'text', 'Final place of delivery (uppercase required)', 'place...')
    +formInput('airlineName', 'text', 'Name of airline', 'Emirates...')
    +formInput('billMasterAirway', 'text', 'Master airway bill number', '123-1234567')
    +formInput('billHouseAirway', 'text', 'House airway bill number', 'AB1234567')
    +formInput('flightNum1', 'text', 'Flight number 1', 'BA123...')
    +formInput('flightDate1', 'text', 'Flight date 1', '20XX-XX-XX')
    +formInput('flightNum2', 'text', 'Flight number 2', 'XY123...')
    +formInput('flightDate2', 'text', 'Flight date 2','20XX-XX-XX' )
    +formInput('etd', 'text', 'ETD', '20XX-XX-XX')
    +formInput('eta', 'text', 'ETA', '20XX-XX-XX')
    +formInput('shippingLineName',  'text','Name of shipping line', 'MSC...')
    +formInput('vesselName', 'text', 'Name of vessel', 'MSC Abcdef...')
    +formInput('voyageName', 'text', 'Voyage number', '123A')
    +formInput('oceanBoLnum', 'text', 'Ocean bill of lading number', '1234567...')
    +formInput('houseBoLnum', 'text', 'House bill of lading number', '1234567...')
    +formInput('containerNum', 'text','Container number', 'ABC12345667...')
    +formInput('sealNum', 'text', 'Seal number', 'ABC12345667...')
    +formInput('shippedOnboardDate', 'text', 'Shipped onboard date', '20XX-XX-XX')
    +formInput('etaFinalPort', 'text', 'ETA Final port', '20XX-XX-XX')
    +formInput('truckRegNo', 'text', 'Truck registration number', 'GP-123-4567')
    +formInput('truckType', 'text', 'Type of truck', 'big truck...')
    .form__group
        input.btn.submit(type='submit')

