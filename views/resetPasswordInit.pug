extends base

block content
    .container
        h1 Let's set a new password
        form.form.reset-password-init-form
            p Please enter your email address so we can send you the reset link
            .form__group 
                label.form__label(for='email') Email address
                input#email.form__input(type='email', placeholder='optimus@example.com', required) 

            .form__group 
                button.btn.btn__reset Submit
