mixin formInput(id, type='text', label, placeholder)
    .form__group
        label.form__label(for=id)= label
        input.form__input(type=type, id=id, placeholder=placeholder)
form.form.data-form__financials
    h2.heading-secondary Financial Details table
    p some text
    +formInput('MasterId', 'number', 'Master ID number', '1, 2, 3...' )
    +formInput('shipperInvoiceNum', 'Shipper invoice number', 'ABC20XX1234ABC')
    +formInput('invoiceDate', 'Invoice date', '20XX-XX-XX')
    +formInput('invoiceAmount', 'Invoice amount', '$100,00')
    +formInput('currency', 'Currency', 'USD/YEN...')
    +formInput('tradeRef', 'Trade reference','12X1XX12' )
    +formInput('apnNum', 'APN number', 'ABCDEFGHIJKLMN123456789')
    +formInput('bank', 'Bank', 'FNB/RMB...')
    +formInput('apnDate', 'APN date', '20XX-XX-XX')
    .form__group
        input.btn.submit(type='submit')